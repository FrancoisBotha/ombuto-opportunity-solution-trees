<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Solution.
    -->
    <changeSet id="20260918102119-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="opportunity_id"
                                 baseTableName="solution"
                                 constraintName="fk_solution__opportunity_id"
                                 referencedColumnNames="id"
                                 referencedTableName="opportunity"
                                 />

        <addForeignKeyConstraint baseColumnNames="owner_id"
                                 baseTableName="solution"
                                 constraintName="fk_solution__owner_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />

        <addForeignKeyConstraint baseColumnNames="solution_id"
                                 baseTableName="rel_solution__tag"
                                 constraintName="fk_rel_solution__tag__solution_id"
                                 referencedColumnNames="id"
                                 referencedTableName="solution"
                                 />

        <addForeignKeyConstraint baseColumnNames="tag_id"
                                 baseTableName="rel_solution__tag"
                                 constraintName="fk_rel_solution__tag__tag_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tag"
                                 />
    </changeSet>
</databaseChangeLog>
