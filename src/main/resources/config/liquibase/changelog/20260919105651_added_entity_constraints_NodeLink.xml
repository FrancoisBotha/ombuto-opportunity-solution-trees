                                 />

        <addForeignKeyConstraint baseColumnNames="evidence_id"
                                 baseTableName="node_link"
                                 constraintName="fk_node_link__evidence_id"
                                 referencedColumnNames="id"
                                 referencedTableName="evidence"
                                 />
