/*
 * Ombuto Opportunity Solution Tree
 * Collaborative (WebSocket) OST tool following Teresa Torres' continuous discovery model.
 *
 * Tree shape:  Product -> Outcome -> Opportunity (nested) -> Solution -> Assumption
 *              Evidence hangs off an Opportunity or an Assumption.
 * Any node can carry NodeLinks; opportunities carry OpenQuestions; NodeHistory is a
 * server-written, append-only changelog per node.
 */

application {
  config {
    baseName opportunitySolutionTree
    applicationType monolith
    packageName com.opportunity.tree
    authenticationType oauth2
    reactive false
    websocket spring-websocket
    databaseType sql
    devDatabaseType h2Disk
    prodDatabaseType postgresql
    cacheProvider ehcache
    enableHibernateCache true
    buildTool maven
    clientFramework vue
    clientTheme pulse
    clientThemeVariant primary
    withAdminUi true
    enableTranslation false
    nativeLanguage en
    testFrameworks [cucumber]
  }
  entities *
}

/* ------------------------------------------------------------------ */
/* Enums                                                               */
/* ------------------------------------------------------------------ */

enum TeamRole {
  OWNER, EDITOR, VIEWER
}

enum OpportunityStatus {
  UNEXPLORED, EXPLORING, VALIDATED, PARKED
}

enum SolutionStatus {
  CANDIDATE, BUILDING, SHIPPED, DROPPED
}

enum AssumptionStatus {
  UNTESTED, TESTING, SUPPORTED, REFUTED
}

enum TreeNodeType {
  PRODUCT, OUTCOME, OPPORTUNITY, SOLUTION, ASSUMPTION, EVIDENCE
}

enum HistoryEventType {
  CREATED, STATUS_CHANGED, CONFIDENCE_CHANGED, PRIORITY_CHANGED, VALUE_CHANGED,
  MOVED, COMMENT_ADDED, COMMENT_DELETED, LINK_ADDED, LINK_REMOVED, QUESTION_ADDED
}

/* ------------------------------------------------------------------ */
/* Organisation                                                        */
/* ------------------------------------------------------------------ */

entity Team {
  name String required minlength(2) maxlength(100)
  description TextBlob
  createdDate Instant required
}

/** Join entity between JHipster User and Team, carrying a role. */
entity TeamMember {
  role TeamRole required
  joinedDate Instant required
}

entity Product {
  name String required minlength(2) maxlength(100)
  description TextBlob
  vision TextBlob
  archived Boolean required
  sortOrder Integer required
  createdDate Instant required
}

/* ------------------------------------------------------------------ */
/* The tree                                                            */
/* ------------------------------------------------------------------ */

/** Desired outcome at the top of the tree, e.g. "Increase weekly active users". */
entity Outcome {
  title String required minlength(2) maxlength(200)
  description TextBlob
  sortOrder Integer required
  createdDate Instant required
  lastModifiedDate Instant
}

/** Customer need, pain point or desire. Nested via parent to form sub-opportunities. */
entity Opportunity {
  title String required minlength(2) maxlength(200)
  description TextBlob
  status OpportunityStatus required
  valuerating Integer required min(1) max(5)
  priority Integer required min(1) max(100)
  sortOrder Integer required
  createdDate Instant required
  lastModifiedDate Instant
}

entity Solution {
  title String required minlength(2) maxlength(200)
  description TextBlob
  status SolutionStatus required
  sortOrder Integer required
  createdDate Instant required
  lastModifiedDate Instant
}

/* ------------------------------------------------------------------ */
/* Discovery                                                           */
/* ------------------------------------------------------------------ */

/** Something that must be true for a solution to work (assumption mapping). */
entity Assumption {
  statement String required minlength(2) maxlength(500)
  description TextBlob
  status AssumptionStatus required
  confidence Integer required min(0) max(100)
  sortOrder Integer required
  createdDate Instant required
  lastModifiedDate Instant
}

/** Interview snippet / test result. Exactly one parent: an Opportunity or an Assumption. */
entity Evidence {
  title String required minlength(2) maxlength(500)
  description TextBlob
  sortOrder Integer required
  createdDate Instant required
  lastModifiedDate Instant
}

/** Weekly customer interview or other evidence source; opportunities are mined from these. */
entity Interview {
  title String required minlength(2) maxlength(200)
  participant String maxlength(200)
  interviewDate LocalDate required
  notes TextBlob
  recordingUrl String maxlength(2000)
  createdDate Instant required
}

/* ------------------------------------------------------------------ */
/* Collaboration                                                       */
/* ------------------------------------------------------------------ */

/** Flat, chat-style comment on a tree node: no replies, no threading. Exactly one of the node relationships is set. */
entity Comment {
  body TextBlob required
  createdDate Instant required
  editedDate Instant
}

/** Name + URL link on any tree node. Exactly one node relationship is set. */
entity NodeLink {
  name String required minlength(1) maxlength(100)
  url String required maxlength(2000) pattern(/^https?:\/\/.+/)
  sortOrder Integer required
  createdDate Instant required
}

/** Checklist item on an opportunity. */
entity OpenQuestion {
  questionText String required minlength(1) maxlength(500)
  done Boolean required
  sortOrder Integer required
  createdDate Instant required
}

/** Append-only per-node changelog, written server-side only. */
entity NodeHistory {
  nodeType TreeNodeType required
  nodeId Long required
  eventType HistoryEventType required
  summary String required maxlength(500)
  createdDate Instant required
}

/** Tag for cross-cutting labels (persona, segment, theme). */
entity Tag {
  name String required minlength(1) maxlength(50)
  colour String maxlength(7) pattern(/^#[0-9A-Fa-f]{6}$/)
}

/* ------------------------------------------------------------------ */
/* Relationships                                                       */
/* ------------------------------------------------------------------ */

relationship ManyToOne {
  TeamMember{team(name) required} to Team
  TeamMember{user(login) required} to User with builtInEntity

  Product{team(name) required} to Team

  Outcome{product(name) required} to Product
  Outcome{owner(login)} to User with builtInEntity

  Opportunity{outcome(title) required} to Outcome
  Opportunity{parent(title)} to Opportunity
  Opportunity{owner(login)} to User with builtInEntity

  Solution{opportunity(title) required} to Opportunity
  Solution{owner(login)} to User with builtInEntity

  Assumption{solution(title) required} to Solution
  Assumption{owner(login)} to User with builtInEntity

  Evidence{opportunity(title)} to Opportunity
  Evidence{assumption(statement)} to Assumption

  Interview{product(name) required} to Product
  Interview{interviewer(login)} to User with builtInEntity

  Comment{author(login) required} to User with builtInEntity
  Comment{outcome(title)} to Outcome
  Comment{opportunity(title)} to Opportunity
  Comment{solution(title)} to Solution
  Comment{assumption(statement)} to Assumption
  Comment{evidence(title)} to Evidence

  NodeLink{product(name)} to Product
  NodeLink{outcome(title)} to Outcome
  NodeLink{opportunity(title)} to Opportunity
  NodeLink{solution(title)} to Solution
  NodeLink{assumption(statement)} to Assumption
  NodeLink{evidence(title)} to Evidence

  OpenQuestion{opportunity(title) required} to Opportunity

  NodeHistory{author(login)} to User with builtInEntity

  Tag{team(name) required} to Team
}

relationship ManyToMany {
  Opportunity{interview(title)} to Interview{opportunity(title)}
  Opportunity{tag(name)} to Tag{opportunity(title)}
  Solution{tag(name)} to Tag{solution(title)}
}

/* ------------------------------------------------------------------ */
/* Options                                                             */
/* ------------------------------------------------------------------ */

dto * with mapstruct
service * with serviceImpl
paginate Opportunity, Solution, Interview, Comment, NodeHistory with pagination
filter Opportunity, Solution, Outcome, Interview
