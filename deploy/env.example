# Copy to deploy/.env (mode 0600) and fill in. Never commit the result.
# Generate each secret with: openssl rand -base64 32

# Image built by `npm run java:docker:prod` (jib) and loaded onto the instance.
# Pin the version tag, never `latest`: a deployment you cannot name is one you cannot
# reason about later. jib tags each build with the project version.
APP_IMAGE=opportunitysolutiontree:0.1.0

# The hostname clients use. Must match the certificate in deploy/tls/.
PUBLIC_HOST=ost.internal.example.com
PUBLIC_URL=https://ost.internal.example.com

APP_DB_NAME=ombutoOpportunitySolutionTree
APP_DB_USER=ombuto
APP_DB_PASSWORD=

KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=

# Bootstrap console admin. Remove from Keycloak's environment once a named
# admin account exists, then restart the keycloak service.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# The realm and client the application authenticates against.
OIDC_ISSUER_URI=https://ost.internal.example.com/realms/jhipster
OIDC_CLIENT_ID=web_app
OIDC_CLIENT_SECRET=
