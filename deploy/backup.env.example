# Copy to /etc/ombuto-backup.env (mode 0600, root-owned) and fill in.
# Read by both backup-to-s3.sh and restore-from-s3.sh.
#
# No AWS credentials belong here: the instance profile supplies them.

S3_BUCKET=ombuto-ost-backups-<account-id>
S3_PREFIX=ombuto-ost
AWS_REGION=eu-west-1

# Must match APP_DB_* / KC_DB_* in deploy/.env
APP_DB_NAME=ombutoOpportunitySolutionTree
APP_DB_USER=ombuto
KC_DB_NAME=keycloak

COMPOSE_DIR=/opt/ombuto-ost/deploy
POSTGRES_SERVICE=postgresql
METRIC_NAMESPACE=Ombuto/Backup
