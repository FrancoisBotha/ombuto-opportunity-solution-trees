{
  "annotations": {
    "changelogDate": "20260918102019"
  },
  "applications": ["opportunitySolutionTree"],
  "documentation": "Named external URL attached to an opportunity, e.g. \"Customer Interview\" pointing at a call recording.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "name",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength"],
      "fieldValidateRulesMaxlength": "100",
      "fieldValidateRulesMinlength": "1"
    },
    {
      "fieldName": "url",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "2000",
      "fieldValidateRulesPattern": "^https?:\\/\\/.+"
    },
    {
      "fieldName": "type",
      "fieldType": "LinkType",
      "fieldValidateRules": ["required"],
      "fieldValues": "PROTOTYPE,TICKET,DOCUMENT,INTERVIEW,ANALYTICS,DESIGN,OTHER"
    },
    {
      "fieldName": "sortOrder",
      "fieldType": "Integer",
      "fieldValidateRules": ["required"]
    }
  ],
  "name": "OpportunityLink",
  "relationships": [
    {
      "otherEntityField": "title",
      "otherEntityName": "opportunity",
      "relationshipName": "opportunity",
      "relationshipSide": "left",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
  "service": "serviceImpl"
}
